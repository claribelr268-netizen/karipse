		nodes(ids: $variants) {
			... on ProductVariant {
				...VariantDetails
				...VariantSellingPlans @include(if: $hasSellingPlan)
				product {
					...ProductDetails
				}
			}
		}
	}
`,c=`
	${o}
	${i}
	${n}
	${a}
