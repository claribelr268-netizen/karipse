`,u=`
	${o}
	${i}
	${n}
	${s}
	${a}

	fragment ProductWithVariantsFragment on Product {
		...ProductDetails
		...ProductVariantsConnection
	}

	fragment AnySlots on QueryRoot {
		products(first: 25) {
			nodes {
