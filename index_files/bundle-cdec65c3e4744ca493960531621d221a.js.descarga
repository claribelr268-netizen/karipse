		reviewsRating: metafield(namespace: "reviews", key: "rating") {
			value
		}
		reviewsRatingCount: metafield(namespace: "reviews", key: "rating_count") {
			value
		}
		collections(first: 50) {
			edges {
				node {
					id
					handle
				}
			}
		}
		images(first: $imagesCount) {
			edges {
				node {
					src
					altText
					height
					width
				}
			}
		}
	}
`,a=`
