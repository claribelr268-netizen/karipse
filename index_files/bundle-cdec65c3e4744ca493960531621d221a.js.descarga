			}
		}
	}

	query ProductsAndCollectionsQuery($country: CountryCode, $language: LanguageCode, $hasSellingPlan: Boolean!, $hasProductInventory: Boolean!, $anySlots: Boolean!, $productsOrCollections: [ID!]!, $collectionProductsLimit: Int!, $imagesCount: Int = 1) @inContext(country: $country, language: $language) {
		...AnySlots @include(if: $anySlots)
		nodes(ids: $productsOrCollections) {
			... on Product {
				...ProductWithVariantsFragment
			}
			... on Collection {
				...CollectionDetails
				products(first: $collectionProductsLimit, filters: {available: true}) {
