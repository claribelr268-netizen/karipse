(function(){function initKbkSliders(){document.querySelectorAll("[data-kbk-slider]").forEach(function(slider){if(slider.dataset.kbkInit)return;slider.dataset.kbkInit="1";var track=slider.querySelector("[data-kbk-track]"),btnPrev=slider.querySelector("[data-kbk-prev]"),btnNext=slider.querySelector("[data-kbk-next]");if(!track)return;function scrollToSlide(dir){var index=Math.round(track.scrollLeft/track.offsetWidth);index=dir==="next"?index+1:index-1,track.scrollTo({left:index*track.offsetWidth,behavior:"smooth"})}btnPrev&&btnPrev.addEventListener("click",function(e){e.preventDefault(),e.stopPropagation(),scrollToSlide("prev")}),btnNext&&btnNext.addEventListener("click",function(e){e.preventDefault(),e.stopPropagation(),scrollToSlide("next")});var dragging=!1,startX=0,scrollStart=0;track.addEventListener("mousedown",function(e){dragging=!0,startX=e.clientX,scrollStart=track.scrollLeft,track.classList.add("is-grabbing"),e.preventDefault()}),window.addEventListener("mousemove",function(e){dragging&&(track.scrollLeft=scrollStart-(e.clientX-startX))}),window.addEventListener("mouseup",function(){if(dragging){dragging=!1,track.classList.remove("is-grabbing");var index=Math.round(track.scrollLeft/track.offsetWidth);track.scrollTo({left:index*track.offsetWidth,behavior:"smooth"})}})})}document.addEventListener("DOMContentLoaded",initKbkSliders),document.addEventListener("shopify:section:load",initKbkSliders)})();
